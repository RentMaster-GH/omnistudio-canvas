{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist"
  },
  "include": ["server.ts", "src/**/*", "server/**/*"],
  "exclude": [
    "node_modules", 
    "client", 
    "outputs", 
    "uploads", 
    "dist", 
    "**/*.test.ts", 
    "**/*.spec.ts",
    "src/services/supabase*"
  ]
}